<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>AuditHistoryExtractorPro.XrmToolBox</id>
    <version>0.1.0</version>
    <title>Audit History Extractor Pro</title>
    <authors>Edwing Alarcón</authors>
    <owners>Edwing Alarcón</owners>
    <description>
      Extrae, exporta (Excel/CSV/JSON) y valida (spot-check) historial de auditoría de
      Dataverse bajo demanda, dentro de XrmToolBox. Fase inicial de distribución interna;
      publicación al Plugin Store planeada una vez validado con usuarios reales.
    </description>
    <releaseNotes>0.1.0: primera versión interna. Extracción + exportación + validación básica.</releaseNotes>
    <tags>XrmToolBox Dataverse Dynamics365 Auditoria Audit</tags>
    <projectUrl>https://github.com/EdwingAlarcon/AuditHistoryExtractorPro-XrmToolBox</projectUrl>
    <license type="expression">MIT</license>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <!--
      Sin <dependencies>: la convención de XrmToolBox para plugins NO es declarar
      dependencias NuGet (el instalador de Tool Library no las resuelve contra nuget.org),
      sino incluir directamente en <files>, bajo lib\net48\Plugins, tanto el/los DLL del
      plugin como cualquier ensamblado de terceros que el host no traiga ya (ver más abajo).
      No incluir ensamblados del SDK de CRM/Dataverse ni del propio XrmToolBox — esos ya
      están cargados en el proceso del host.
    -->
  </metadata>
  <files>
    <!-- Ensamblados propios -->
    <file src="..\src\AuditHistoryExtractorPro.XrmToolBox.Plugin\bin\Release\net48\AuditHistoryExtractorPro.XrmToolBox.Plugin.dll" target="lib\net48\Plugins" />
    <file src="..\src\AuditHistoryExtractorPro.XrmToolBox.Core\bin\Release\net48\AuditHistoryExtractorPro.XrmToolBox.Core.dll" target="lib\net48\Plugins" />
    <file src="..\src\AuditHistoryExtractorPro.XrmToolBox.Plugin\Resources\PluginPackage.png" target="lib\net48\Plugins" />

    <!--
      Dependencias de terceros que el host de XrmToolBox NO trae (las necesita Core.dll
      en runtime para exportar a Excel/CSV): ClosedXML y su árbol de dependencias, y
      CsvHelper. Tomadas del bin de Release del Plugin, donde ya quedan copiadas por
      MSBuild al resolver los PackageReference.
    -->
    <file src="..\src\AuditHistoryExtractorPro.XrmToolBox.Plugin\bin\Release\net48\ClosedXML.dll" target="lib\net48\Plugins" />
    <file src="..\src\AuditHistoryExtractorPro.XrmToolBox.Plugin\bin\Release\net48\CsvHelper.dll" target="lib\net48\Plugins" />
    <file src="..\src\AuditHistoryExtractorPro.XrmToolBox.Plugin\bin\Release\net48\DocumentFormat.OpenXml.dll" target="lib\net48\Plugins" />
    <file src="..\src\AuditHistoryExtractorPro.XrmToolBox.Plugin\bin\Release\net48\ExcelNumberFormat.dll" target="lib\net48\Plugins" />
    <file src="..\src\AuditHistoryExtractorPro.XrmToolBox.Plugin\bin\Release\net48\SixLabors.Fonts.dll" target="lib\net48\Plugins" />
    <file src="..\src\AuditHistoryExtractorPro.XrmToolBox.Plugin\bin\Release\net48\XLParser.dll" target="lib\net48\Plugins" />
    <file src="..\src\AuditHistoryExtractorPro.XrmToolBox.Plugin\bin\Release\net48\Irony.dll" target="lib\net48\Plugins" />
    <file src="..\src\AuditHistoryExtractorPro.XrmToolBox.Plugin\bin\Release\net48\System.IO.Packaging.dll" target="lib\net48\Plugins" />
  </files>
</package>
