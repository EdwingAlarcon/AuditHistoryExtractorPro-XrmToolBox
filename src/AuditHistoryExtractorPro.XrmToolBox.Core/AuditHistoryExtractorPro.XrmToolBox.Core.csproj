    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>AuditHistoryExtractorPro.XrmToolBox.Core</AssemblyName>
    <RootNamespace>AuditHistoryExtractorPro.XrmToolBox.Core</RootNamespace>
